# AeroTrade-XAI environment configuration (template)
# Copy to .env and fill in real values. Never commit real secrets.

# Provide ONE provider key. Priority order: Hugging Face -> Gemini -> OpenAI.
# Google Gemini (recommended default)
GEMINI_API_KEY=your_gemini_key_here

# Hugging Face Inference API
# HUGGINGFACEHUB_API_TOKEN=your_hugging_face_token_here

# OpenAI-compatible endpoint
# OPENAI_API_KEY=your_openai_key_here
